# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/rideout"
PORT=3001

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# eBay OAuth
EBAY_CLIENT_ID="your-ebay-client-id"
EBAY_CLIENT_SECRET="your-ebay-client-secret"
EBAY_RUNAME="your-ebay-runame"
EBAY_ENVIRONMENT="sandbox"  # or "production"
EBAY_TOKEN_ENCRYPTION_KEY="32-byte-hex-key-for-aes-256-cbc"

# Email (Nodemailer)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@rideout.app"

# File uploads (Cloudinary — optional, falls back to local storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frontend URL (for CORS + invite links)
WEB_URL="http://localhost:5173"

# ── Web ──────────────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001/api/v1"
VITE_SOCKET_URL="http://localhost:3001"
VITE_GOOGLE_CLIENT_ID="your-google-client-id"
